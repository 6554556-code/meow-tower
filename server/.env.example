# Скопируй этот файл в .env (рядом) и впиши настоящие значения.
# .env никому не отправляй — там токен бота.

# Токен бота от @BotFather
BOT_TOKEN=123456789:ВСТАВЬ_СЮДА_ТОКЕН

# Порт, на котором слушает сервер (nginx перенаправляет сюда)
PORT=3100

# 1 — режим разработчика: можно войти без Telegram по адресу ...?dev=имя
# На настоящем сервере оставь 0
DEV=0
